# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Read by macrosignal.config.settings.Settings; committed research configs
# under configs/ must never contain secrets or machine-specific paths.

MACROSIGNAL_ENV=development
# MACROSIGNAL_DATA_DIR=data
# MACROSIGNAL_REPORTS_DIR=reports

# API keys: MACROSIGNAL_-prefixed names win over the conventional names below.
FRED_API_KEY=
BEA_API_KEY=
MARKET_DATA_API_KEY=
